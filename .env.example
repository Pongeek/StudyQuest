# ============================================================================
# StudyQuest — environment variables
# Copy this file to `.env.local` and fill in the real values. Never commit
# `.env.local` to git. For production, set the same variables in the Vercel
# Project → Settings → Environment Variables dashboard.
# ============================================================================

# ── Clerk (auth) ───────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
# The publishable key is safe to expose in the browser; the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs — keep these defaults unless you renamed the routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Supabase (database + storage) ──────────────────────────────────────────
# Get these from https://supabase.com → your project → Project Settings → API
# The anon key is safe to expose; the service_role key bypasses RLS and is
# server-only. Never expose it in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic (Claude API — powers quiz extraction, grading, debriefs) ─────
# Get this from https://console.anthropic.com → API Keys
# Server-only — never expose in the browser.
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx

# ── App ────────────────────────────────────────────────────────────────────
# In development: http://localhost:3000
# In production: your Vercel deployment URL (e.g. https://studyquest.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
